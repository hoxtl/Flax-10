{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "preDeployCommand": "cd flax-10-project-files/backend && mkdir static && python manage.py migrate && python manage.py collectstatic --noinput",
    "startCommand": "gunicorn studyFlax.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --threads 4 --timeout 120",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/",
    "healthcheckTimeout": 100
  }
}