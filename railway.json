{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
  },
  "deploy": {
    "preDeployCommand": ["python flax-10-project-files/backend/manage.py migrate"],["python flax-10-project-files/backend/manage.py collectstatic --noinput"]
    "startCommand": "gunicorn Flax10.wsgi:application --bind 0.0.0.0:$PORT",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "never"
  }
}